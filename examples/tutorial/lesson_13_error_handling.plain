rem: Lesson 13 - Error Handling
rem: Gracefully handling errors with attempt/handle/ensure

rem: A function that may abort
task ValidateAge using (age)
    if age < 0
        abort "Age cannot be negative"
    if age > 150
        abort "Age seems unrealistic"
    deliver age

task Main()
    rem: Basic error handling - no error occurs
    display("=== Safe Division ===")
    attempt
        var result = 10 / 3
        display("  10 / 3 = " & result)
    handle
        display("  An error occurred!")
    display("")

    rem: Error handling - division by zero
    rem: `handle err` captures the actual error message into a variable,
    rem: instead of just a generic "something went wrong" -- use this
    rem: whenever the message itself is useful to the person seeing it.
    display("=== Division by Zero ===")
    attempt
        var bad = 10 / 0
        display("  This won't print")
    handle err
        display("  Caught an error: " & err)
    display("")

    rem: Using abort to signal errors
    display("=== Age Validation ===")
    attempt
        var age1 = ValidateAge(25)
        display("  Valid age: " & age1)
    handle err
        display("  Age was rejected: " & err)
    display("")

    attempt
        var age2 = ValidateAge(-5)
        display("  This won't print")
    handle err
        display("  Age was rejected: " & err)
    display("")

    attempt
        var age3 = ValidateAge(200)
        display("  This won't print")
    handle err
        display("  Age was rejected: " & err)
    display("")

    rem: Multiple handle clauses can match specific error messages --
    rem: handlers are tried in order, and a name-binding handler (no
    rem: pattern to match against) always matches, so it belongs last.
    display("=== Pattern Matching Handlers ===")
    attempt
        ValidateAge(300)
    handle "unrealistic"
        display("  That age is out of range on the high end.")
    handle err
        display("  Rejected for a different reason: " & err)
    display("")

    rem: Ensure block always runs, even after an error
    display("=== Cleanup with Ensure ===")
    attempt
        display("  Working...")
        abort "Something went wrong"
    handle err
        display("  Error was caught: " & err)
    ensure
        display("  Cleanup complete (always runs).")
    display("")

    display("Program finished gracefully!")
